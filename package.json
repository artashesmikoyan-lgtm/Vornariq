{
  "name": "vornariq",
  "version": "0.0.1",
  "description": "Intelligent orchestration for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artashesmikoyan-lgtm/Vornariq.git"
  },
  "bugs": {
    "url": "https://github.com/artashesmikoyan-lgtm/Vornariq/issues"
  },
  "homepage": "https://github.com/artashesmikoyan-lgtm/Vornariq#readme",
  "keywords": [
    "coding-agents",
    "orchestration",
    "cli",
    "codex",
    "gemini"
  ],
  "type": "module",
  "private": false,
  "bin": {
    "vornariq": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
